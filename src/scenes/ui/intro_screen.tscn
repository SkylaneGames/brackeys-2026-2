material = SubResource("ShaderMaterial_crawl")
offset_left = 360.0
offset_right = 920.0
offset_bottom = 1300.0
pivot_offset = Vector2(280, 0)
theme_override_colors/font_color = Color(0.97, 0.79, 0.31, 1)
