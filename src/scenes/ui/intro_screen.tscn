theme_override_constants/line_spacing = 14
theme_override_constants/shadow_offset_x = 2
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 27
text = "OUTER REACH // CYCLE 4097\n\nThe last human convoy enters an uncharted asteroid storm. The asteroid field, regrettably, has declined to queue.\n\nIts pilot cannot see far enough to navigate alone. Mission Control has described the situation as less than ideal, which is rarely encouraging.\n\nTwo navigation intelligences awaken: ALPHA and BETA. Each offers a path through the dark. One protects the ship. One accepts the risk. Both insist they are helping. Neither has provided references.\n\nTheir loyalties will change. Their voices will not.\n\nRead the routes. Choose who to trust. Take control when trust is not enough.\n\nDo try to keep the ship in one piece. The paperwork is formidable."
horizontal_alignment = 1
autowrap_mode = 2

